    # ── Neon PostgreSQL ──
# Neon dashboard → your project → Connect.
# DATABASE_URL = the POOLED connection string (host contains "-pooler")
# DIRECT_URL   = the DIRECT connection string (same, without "-pooler") — used by migrations
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/fishport?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/fishport?sslmode=require"

# ── API ──
PORT=4000
JWT_SECRET="change-me-to-a-long-random-string"
CORS_ORIGIN="http://localhost:3000"

# Run the scheduled data quality scan (every 15 minutes). Set to "false" to disable.
DQ_SCHEDULER=true
